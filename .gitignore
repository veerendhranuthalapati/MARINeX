# Bulk AIS parquet partitions (regenerated by scripts/prepare_ais.py)
data/processed/ais/partitions/**
!data/processed/ais/partitions/.gitkeep
data/processed/ais/*.duckdb
# Detection run artifacts (recreated per demo/test run)
data/processed/detections/**
!data/processed/detections/.gitkeep

# DuckDB working files
*.duckdb
*.duckdb.wal

# MLflow artifacts
mlruns/
mlartifacts/
models/mlflow/

