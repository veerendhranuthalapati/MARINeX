# MARINeX Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database
# Local SQLite default (zero configuration needed)
DATABASE_URL=sqlite:///./marinex.db
USE_POSTGIS=false

# Docker / Production PostgreSQL + PostGIS (uncomment when using docker-compose)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marinex
# USE_POSTGIS=true
# POSTGRES_DB=marinex
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432

# Attribution Scoring Engine Weights (must sum to ~1.0)
WEIGHT_PROXIMITY=0.35
WEIGHT_TEMPORAL=0.25
WEIGHT_TRAJECTORY=0.25
WEIGHT_BEHAVIOR=0.15

# Drift Simulation Defaults
DEFAULT_WIND_DRIFT_FACTOR=0.032
DEFAULT_DIFFUSION_COEFF=10.0

# External API Keys & Providers (Optional future integration)
# COPERNICUS_MARINE_USER=
# COPERNICUS_MARINE_PASSWORD=
# AIS_STREAM_API_KEY=
